# 可选：课堂 id；不填则启动后在 WebUI「设置」里选择正在上课的课堂
LESSON_ID=
# 本地 HTTP 端口
PORT=8799
# 一键启动时是否自动打开浏览器（0 关闭）
OPEN=1
# 自定义状态目录 / cookie 文件（默认都放在 state/）
# STATE_DIR=./state
# COOKIE_FILE=./state/cookies.json

# DeepSeek 视觉解题；也可以在 WebUI 设置里填 Key（优先 WebUI）
DEEPSEEK_API_KEY=
DS_MODEL=deepseek-flash
# DS_EFFORT=high

# 自动化开关
AUTO=1
AUTO_SOLVE=1
MIN_DELAY_MS=40000
SOLVE_RETRIES=2
# 单题解题（含重试）总时长上限，毫秒
SOLVE_DEADLINE_MS=120000
SUBMIT_RETRIES=2

# 弹幕高峰跟发
DANMU=1
DANMU_SEND=1
DANMU_WINDOW_MS=60000
DANMU_THRESHOLD=8
DANMU_MIN_REPEAT=3
DANMU_QUIET_MS=30000
DANMU_MAX_PEAK_MS=120000
DANMU_MAX_LEN=50

# 点名监控（只提醒，不自动应答）
ROLLCALL=1
